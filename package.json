{
  "name": "opencode-antigravity-auth-remix",
  "version": "1.0.0",
  "description": "Enhanced fork: Antigravity + Gemini CLI OAuth + google_search tool for Opencode",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "license": "MIT",
  "author": "darkstarrd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darkstarrd-dev/opencode-antigravity-auth.git"
  },
  "homepage": "https://github.com/Darkstarrd-dev/opencode-antigravity-auth#readme",
  "bugs": {
    "url": "https://github.com/Darkstarrd-dev/opencode-antigravity-auth/issues"
  },
  "keywords": [
    "opencode",
    "google",
    "antigravity",
    "gemini",
    "oauth",
    "plugin",
    "auth",
    "claude"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:schema": "npx tsx script/build-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "test:e2e:models": "npx tsx script/test-models.ts",
    "test:e2e:regression": "npx tsx script/test-regression.ts"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^0.15.30",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^3.0.0",
    "@vitest/ui": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "zod-to-json-schema": "^3.25.0"
  },
  "dependencies": {
    "@openauthjs/openauth": "^0.4.3",
    "xdg-basedir": "^5.1.0",
    "zod": "^3.24.0"
  }
}
